{
  "name": "citebase-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:style": "node scripts/check-style-tokens.mjs && node scripts/check-theme-contract.mjs && node scripts/check-icon-consistency.mjs && node scripts/check-design-doctrine.mjs && node scripts/check-contrast.mjs && node scripts/check-glass-layers.mjs && node scripts/check-layout-contract.mjs",
    "check:i18n-msg": "node scripts/i18n-msg-audit.mjs",
    "check:i18n-runtime": "node scripts/check-i18n-runtime.mjs",
    "gen:server-messages": "node scripts/gen-server-messages.mjs",
    "check:icons": "node scripts/check-icon-consistency.mjs",
    "check:icons:selftest": "node scripts/check-icon-consistency.mjs --selftest",
    "check:design": "node ../scripts/check-design.mjs .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:glass": "node scripts/check-glass-layers.mjs",
    "check:glass:runtime": "node scripts/check-glass-runtime.mjs",
    "check:theme-rounds": "node scripts/check-theme-rounds.mjs",
    "check:theme": "node scripts/check-theme-contract.mjs",
    "check:layout": "node scripts/check-layout-contract.mjs",
    "check:gates:rv": "node scripts/rv-design-gates.mjs",
    "check:ui": "node scripts/check-ui-consistency.mjs",
    "check:geom": "node scripts/check-layout-geometry.mjs",
    "check:geom:selftest": "node scripts/check-layout-geometry.mjs --selftest",
    "check:dialog": "node scripts/check-dialog-layout.mjs",
    "check:detail": "node scripts/check-page-detail.mjs",
    "check:elements": "node scripts/check-element-tokens.mjs",
    "check:motion": "node scripts/check-motion-consistency.mjs",
    "check:gesture": "node scripts/check-gesture-dynamics.mjs",
    "check:gesture:selftest": "node scripts/check-gesture-dynamics.mjs --selftest",
    "check:parity": "node scripts/check-page-parity.mjs",
    "check:parity:selftest": "node scripts/check-page-parity.mjs --selftest",
    "check:boxes": "node scripts/check-box-census.mjs",
    "check:boxes:selftest": "node scripts/check-box-census.mjs --selftest",
    "check:apple": "node scripts/check-apple-design.mjs",
    "check:apple:selftest": "node scripts/check-apple-design.mjs --selftest",
    "check:apple:table": "node scripts/check-apple-design.mjs --table",
    "check:visual": "node scripts/check-visual-signature.mjs",
    "check:visual:selftest": "node scripts/check-visual-signature.mjs --selftest",
    "check:motion:selftest": "node scripts/check-motion-consistency.mjs --selftest",
    "check:stress": "node scripts/check-long-content.mjs",
    "check:stress:selftest": "node scripts/check-long-content.mjs --selftest",
    "check:runtime": "node scripts/check-runtime-ego.mjs",
    "check:runtime:pw": "node scripts/check-runtime-errors.mjs",
    "check:runtime:selftest": "node scripts/check-runtime-errors.mjs --selftest",
    "check:api-exports": "node scripts/check-dead-api-exports.mjs",
    "snap": "node scripts/visual-snapshot.mjs",
    "gen:theme-preview": "node scripts/gen-theme-preview.mjs",
    "gen:theme-icons": "node scripts/gen-theme-icons.mjs",
    "prepare": "cd .. && node web/node_modules/husky/bin.js",
    "ci": "npm run lint:check && npm run type-check && npm run check:style && npm run check:i18n-msg && npm run test && npm run build",
    "gen:brand-preview": "node scripts/gen-brand-preview.mjs",
    "gen:brand-icons": "node scripts/gen-brand-icons.mjs"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.15.1",
    "dompurify": "^3.2.7",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "lib0": "^0.2.117",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.2",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.55.1",
    "morphicons": "^1.7.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.0.4",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.59.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.3.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
