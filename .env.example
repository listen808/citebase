# ============================================
# Citebase Docker 部署环境变量配置
# ============================================
# 使用方法:
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 修改 .env 中的值（特别是密码和密钥）
#   3. 启动: docker compose up -d
# ============================================
# 关于变量前缀：项目 2026-10-07 从 AIWiki 改名为 Citebase，但**这一份模板继续用 AIWIKI_* 名字**。
# 原因是 viper 与 os.Getenv 对认不出的键一律静默丢弃 —— 把已有的 AIWIKI_* 一次性改名，
# 等于让所有现存 .env 与 start.bat 全部失效，而启动日志照样打印一句"配置加载成功"。
# 应用侧走的是双读（CITEBASE_* 优先、AIWIKI_* 兜底），所以不用 Docker 的部署可以两种名字都设；
# 用 compose 的按这份模板填就行。旧名会在一个发布周期后摘除，届时这里会换成新名。
# ============================================

# MySQL 数据库配置
# 必须改成强随机口令（compose 已改为缺失即报错，不再提供弱默认值）
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
# compose 会在该值缺失时直接报错退出
MYSQL_PASSWORD=CHANGE_ME_app_password
MYSQL_DATABASE=citebase
MYSQL_USER=citebase

MYSQL_PORT=3306

# 应用服务端口
APP_PORT=3001

# JWT 密钥（生产环境必须设置为随机字符串，至少 32 位）
# 生成方法: openssl rand -hex 32
JWT_SECRET=

# 凭据加密密钥（数据源口令 / SMTP 口令的 AES-GCM 静态加密）
# 留空 = 应用首启在 data/.encrypt_key 生成一把并持久化。单容器可以，
# **多副本部署必须显式设置**：否则每个副本各生成一把，A 加密的口令 B 解不开，
# 而解不开会被当成明文回灌给目标库 —— 表现是"认证失败"而不是"密钥不对"。
# 生成方法: openssl rand -hex 32
AIWIKI_ENCRYPT_KEY=

# 运行环境 (production/debug)
AIWIKI_ENV=production

# ============================================
# 可选: 构建与端口
# ============================================
# 镜像构建时把 commit 注进二进制，管理端 /stats/server 才答得出"这是哪个 commit 建的"。
# 不设就是 dev（宁可显示 dev，也不显示一个假 hash）。
# COMMIT=
# REDIS_PORT=6379
# QDRANT_PORT=6333

# ============================================
# 可选: AI 配置（通过环境变量覆盖 config.yaml）
# ============================================
# 注意变量名**没有 AIWIKI_ 前缀**（代码读的是这一组无前缀名字）。
# AI_ENABLED=true
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-api-key-here
